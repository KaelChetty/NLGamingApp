<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bookingMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080A08"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="#111611">

            <ImageView
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:src="@drawable/nl_logo"
                android:scaleType="fitCenter"
                android:contentDescription="Next Level Gaming logo" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="NEXT LEVEL"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/btnBookingMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="☰"
                android:textColor="#00FF41"
                android:textSize="30sp"
                android:gravity="center"
                android:contentDescription="Open navigation menu" />

        </LinearLayout>

        <!-- GREEN DIVIDER -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#00FF41" />

        <!-- PAGE INTRODUCTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="#102010">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BOOKING DETAILS"
                android:textColor="#00FF41"
                android:textSize="28sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="You're one step closer to your next gaming experience!"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:gravity="center" />

        </LinearLayout>

        <!-- MAIN CONTENT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- BOOKING OVERVIEW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#172117">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="YOUR BOOKING"
                    android:textColor="#00FF41"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtBookingExperience"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Experience: Not selected"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/txtBookingQuantity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Quantity: 0"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/txtBookingTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Total: R0.00"
                    android:textColor="#00FF41"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- PERSONAL INFORMATION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="YOUR INFORMATION"
                android:textColor="#00FF41"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- FULL NAME -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Full Name *"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtBookingName"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:hint="Enter your full name"
                android:inputType="textPersonName"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#999999"
                android:backgroundTint="#00FF41"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- EMAIL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Email Address *"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtBookingEmail"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:hint="Enter your email address"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#999999"
                android:backgroundTint="#00FF41"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- PHONE NUMBER -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Phone Number *"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtBookingPhone"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:hint="Enter your phone number"
                android:inputType="phone"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#999999"
                android:backgroundTint="#00FF41"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- BOOKING PREFERENCES -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="BOOKING PREFERENCES"
                android:textColor="#00FF41"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- DATE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Preferred Booking Date *"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtBookingDate"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:hint="Tap to select a date"
                android:inputType="none"
                android:focusable="false"
                android:clickable="true"
                android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                android:drawablePadding="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#999999"
                android:backgroundTint="#00FF41"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- TIME -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Preferred Booking Time *"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtBookingTime"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:hint="Tap to select a time"
                android:inputType="none"
                android:focusable="false"
                android:clickable="true"
                android:drawableEnd="@android:drawable/ic_menu_recent_history"
                android:drawablePadding="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#999999"
                android:backgroundTint="#00FF41"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- ADDITIONAL REQUESTS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Additional Requests (Optional)"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtBookingRequests"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:hint="Anything else we should know?"
                android:inputType="textMultiLine|textCapSentences"
                android:gravity="top|start"
                android:textColor="#FFFFFF"
                android:textColorHint="#999999"
                android:backgroundTint="#00FF41"
                android:padding="12dp" />

            <!-- REQUIRED FIELD NOTE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="* Required fields"
                android:textColor="#AAAAAA"
                android:textSize="13sp" />

            <!-- CONTINUE BUTTON -->
            <Button
                android:id="@+id/btnReviewBooking"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="25dp"
                android:text="REVIEW MY BOOKING"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#00FF41" />

            <!-- BACK BUTTON -->
            <Button
                android:id="@+id/btnBookingBack"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:text="BACK TO CALCULATOR"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#304030" />

        </LinearLayout>

        <!-- FOOTER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="#003B13"
            android:padding="24dp">

            <ImageView
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:src="@drawable/nl_logo"
                android:scaleType="fitCenter"
                android:contentDescription="Next Level Gaming footer logo" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="NEXT LEVEL GAMING &amp; ESPORTS ARENA"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Your Game. Your Arena."
                android:textColor="#CCFFCC"
                android:textSize="14sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/footerBookingContact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="CONTACT US"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="FACEBOOK   |   INSTAGRAM   |   TIKTOK"
                android:textColor="#CCFFCC"
                android:textSize="12sp"
                android:gravity="center" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="16dp"
                android:background="#66FF88" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Terms &amp; Conditions"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="5dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Privacy Policy"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="5dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="© 2026 Next Level Gaming &amp; Esports Arena"
                android:textColor="#CCFFCC"
                android:textSize="11sp"
                android:gravity="center" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
