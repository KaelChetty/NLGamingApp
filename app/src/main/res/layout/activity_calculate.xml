<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calculateMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080A08"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="#111611">

            <ImageView
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:src="@drawable/nl_logo"
                android:scaleType="fitCenter"
                android:contentDescription="Next Level Gaming logo" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="NEXT LEVEL"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/btnCalculateMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="☰"
                android:textColor="#00FF41"
                android:textSize="30sp"
                android:gravity="center"
                android:contentDescription="Open navigation menu" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#00FF41" />

        <!-- PAGE INTRODUCTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="#102010">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CALCULATE YOUR FEES"
                android:textColor="#00FF41"
                android:textSize="28sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Choose your experience and calculate your estimated booking total."
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:gravity="center"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

        <!-- BOOKING CALCULATOR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BOOKING CALCULATOR"
                android:textColor="#00FF41"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- EXPERIENCE SELECTION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Select Your Experience"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerExperience"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#00FF41"
                android:background="#172117"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:contentDescription="Select a gaming experience" />

            <TextView
                android:id="@+id/txtSelectedPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Experience price: R0.00"
                android:textColor="#00FF41"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- QUANTITY INPUT -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Number of Bookings"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtQuantity"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#00FF41"
                android:hint="Enter quantity (e.g. 2)"
                android:inputType="number"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textColorHint="#999999"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- DISCOUNT INFORMATION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#172117">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="QUANTITY DISCOUNTS"
                    android:textColor="#00FF41"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="1 booking       No discount&#10;2 bookings     5% discount&#10;3 bookings     10% discount&#10;4+ bookings   15% discount"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:lineSpacingExtra="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="VAT of 15% is added after the discount."
                    android:textColor="#CCFFCC"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- CALCULATE BUTTON -->
            <Button
                android:id="@+id/btnCalculateFees"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="26dp"
                android:text="CALCULATE TOTAL"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#00FF41" />

            <!-- RESULTS CARD -->
            <LinearLayout
                android:id="@+id/layoutCalculationResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#172117">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="YOUR PRICE BREAKDOWN"
                    android:textColor="#00FF41"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtSubtotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Subtotal: R0.00"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/txtDiscount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Discount (0%): -R0.00"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/txtAfterDiscount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="After Discount: R0.00"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/txtVat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="VAT (15%): R0.00"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="16dp"
                    android:background="#00FF41" />

                <TextView
                    android:id="@+id/txtGrandTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TOTAL: R0.00"
                    android:textColor="#00FF41"
                    android:textSize="27sp"
                    android:textStyle="bold"
                    android:gravity="center" />

            </LinearLayout>

            <!-- CONTINUE BUTTON -->
            <Button
                android:id="@+id/btnContinueBooking"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="24dp"
                android:text="CONTINUE TO BOOKING"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#00FF41" />

            <Button
                android:id="@+id/btnCalculateBack"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:text="BACK TO EXPERIENCES"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#304030" />

        </LinearLayout>

        <!-- FOOTER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="#003B13"
            android:padding="24dp">

            <ImageView
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:src="@drawable/nl_logo"
                android:scaleType="fitCenter"
                android:contentDescription="Next Level Gaming footer logo" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="NEXT LEVEL GAMING &amp; ESPORTS ARENA"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Your Game. Your Arena."
                android:textColor="#CCFFCC"
                android:textSize="14sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/footerCalculateContact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="CONTACT US"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="FACEBOOK   |   INSTAGRAM   |   TIKTOK"
                android:textColor="#CCFFCC"
                android:textSize="12sp"
                android:gravity="center" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="16dp"
                android:background="#66FF88" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Terms &amp; Conditions"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="5dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Privacy Policy"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="5dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="© 2026 Next Level Gaming &amp; Esports Arena"
                android:textColor="#CCFFCC"
                android:textSize="11sp"
                android:gravity="center" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
