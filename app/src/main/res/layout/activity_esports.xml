<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/esportsMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080A08"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="#111611">

            <ImageView
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:src="@drawable/nl_logo"
                android:scaleType="fitCenter"
                android:contentDescription="Next Level Gaming logo" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="NEXT LEVEL"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/btnEsportsMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="☰"
                android:textColor="#00FF41"
                android:textSize="30sp"
                android:gravity="center"
                android:contentDescription="Open navigation menu" />

        </LinearLayout>

        <!-- GREEN DIVIDER -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#00FF41" />

        <!-- HERO BANNER -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:src="@drawable/nl_esports"
            android:scaleType="centerCrop"
            android:contentDescription="Esports Training Package coaching and competitive gaming" />

        <!-- MAIN CONTENT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- PAGE TITLE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ESPORTS TRAINING PACKAGE"
                android:textColor="#00FF41"
                android:textSize="26sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Develop your skills and take your competitive gaming further."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center"
                android:lineSpacingExtra="4dp" />

            <!-- ABOUT THE EXPERIENCE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="ABOUT THE EXPERIENCE"
                android:textColor="#00FF41"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="The Esports Training Package is designed for players who want to improve their gaming abilities and develop a more competitive mindset. It focuses on building important gaming skills, understanding gameplay strategies and developing the teamwork needed in competitive environments. Whether you are new to esports or looking to improve, this experience provides an opportunity to grow as a player."
                android:textColor="#DDDDDD"
                android:textSize="15sp"
                android:lineSpacingExtra="5dp" />

            <!-- HIGHLIGHTS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:padding="20dp"
                android:orientation="vertical"
                android:background="#172117">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EXPERIENCE HIGHLIGHTS"
                    android:textColor="#00FF41"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="• Competitive gaming skill development&#10;• Gameplay strategy and decision-making&#10;• Teamwork and communication&#10;• Building confidence through practice"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:lineSpacingExtra="9dp" />

            </LinearLayout>

            <!-- PRICE CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:padding="20dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#172117">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EXPERIENCE PRICE"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="R1 500"
                    android:textColor="#00FF41"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:gravity="center" />

            </LinearLayout>

            <!-- BOOKING BUTTON -->
            <Button
                android:id="@+id/btnEsportsBookNow"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="25dp"
                android:text="BOOK THIS EXPERIENCE"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#00FF41" />

            <!-- BACK BUTTON -->
            <Button
                android:id="@+id/btnEsportsBack"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:text="BACK TO EXPERIENCES"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#304030" />

        </LinearLayout>

        <!-- FOOTER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="#003B13"
            android:padding="24dp">

            <ImageView
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:src="@drawable/nl_logo"
                android:scaleType="fitCenter"
                android:contentDescription="Next Level Gaming footer logo" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="NEXT LEVEL GAMING &amp; ESPORTS ARENA"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Your Game. Your Arena."
                android:textColor="#CCFFCC"
                android:textSize="14sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/footerEsportsContact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="CONTACT US"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="FACEBOOK   |   INSTAGRAM   |   TIKTOK"
                android:textColor="#CCFFCC"
                android:textSize="12sp"
                android:gravity="center" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="16dp"
                android:background="#66FF88" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Terms &amp; Conditions"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="5dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Privacy Policy"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="5dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="© 2026 Next Level Gaming &amp; Esports Arena"
                android:textColor="#CCFFCC"
                android:textSize="11sp"
                android:gravity="center" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>